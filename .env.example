# Google Health API Configuration
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Google OAuth Tokens
# These will be generated after authorization
GOOGLE_REFRESH_TOKEN=
GOOGLE_ACCESS_TOKEN=

# Temporary auth code (used only during initial setup)
GOOGLE_AUTH_CODE=

# Slack Configuration
# Get this from: https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=

# Monitoring Configuration
# Cron schedule for checking sleep data (default: every 15 minutes)
# Format: minute hour day month weekday
# Examples:
#   */15 * * * * = every 15 minutes
#   */5 * * * *  = every 5 minutes
#   0 * * * *    = every hour
CHECK_INTERVAL=*/5 * * * *

TIMEZONE=Asia/Hong_Kong
